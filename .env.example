# Copy to .env and adjust as needed.

# libSQL / Turso (local file for development; use libsql://… for remote)
DATABASE_URL="file:./data/mnemonic.db"
# Optional; required for remote Turso. Local file DBs can omit or use a placeholder.
# DATABASE_AUTH_TOKEN=

# Better Auth (see https://www.better-auth.com/docs/installation)
# Generate with:
#   nubx @better-auth/cli secret
BETTER_AUTH_SECRETS="1:..."
# The origin the app is served from. Passkeys are bound to this hostname (it becomes the WebAuthn
# rpID), so changing it later invalidates every credential already registered.
BETTER_AUTH_URL="http://localhost:3000"

# Optional comma-separated list of emails allowed to sign up and hold a session.
# "*" matches any username: "you@example.com,*@example.org". Unset to allow anyone.
# ALLOWED_EMAILS=

# Ordered comma-separated `version:hexkey` list encrypting stored provider API keys.
# The first entry encrypts new values; the rest only decrypt. To rotate, prepend a fresh
# key, run the re-encrypt action in /settings/admin, then remove the old entry from every
# process. Rotation only helps after every row is re-encrypted; dumps taken before that
# stay decryptable with the stolen key.
# Generate a key with:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ENCRYPTION_KEYS="1:..."

# Local Firecrawl (docker compose service firecrawl-api)
FIRECRAWL_API_URL="http://localhost:4010"

# Durable agent stream transport: carries run events between the process that drives a run
# and the one serving a reconnect (docker compose service `redis`).
REDIS_URL="redis://localhost:6379"

# RustFS / S3-compatible artifact storage (matches docker-compose.yml service `rustfs`)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="rustfsadmin"
S3_SECRET_ACCESS_KEY="rustfsadmin"
S3_BUCKET="mnemonic-files"
S3_FORCE_PATH_STYLE="true"
