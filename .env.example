# Copy to .env and adjust as needed.

# libSQL / Turso (local file for development; use libsql://… for remote)
DATABASE_URL="file:./data/mnemonic.db"
# Optional; required for remote Turso. Local file DBs can omit or use a placeholder.
# DATABASE_AUTH_TOKEN=

# Better Auth (see https://www.better-auth.com/docs/installation)
# Required for self-host / production-like runs. Generate with:
#   deno run -A npm:@better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Self-hosted Firecrawl (docker compose service firecrawl-api)
FIRECRAWL_API_URL="http://localhost:3002"

# RustFS / S3-compatible artifact storage (matches docker-compose.yml service `rustfs`)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="rustfsadmin"
S3_SECRET_ACCESS_KEY="rustfsadmin"
S3_BUCKET="mnemonic-files"
S3_FORCE_PATH_STYLE="true"
