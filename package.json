{
  "name": "mnemonic",
  "private": true,
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "dev": "deno run -A --unstable-no-legacy-abort npm:vite dev",
    "build": "vite build",
    "preview": "deno run -A --unstable-no-legacy-abort npm:vite preview",
    "test": "vitest run --typecheck",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "fix": "deno task lint && deno task format",
    "translate": "gt generate",
    "docker:dev": "docker compose --profile selfhost rm -sf app && docker compose --profile host up -d --wait && docker compose --profile host run --rm rustfs-init",
    "docker:reset-dev": "docker compose --profile host down -v",
    "docker:selfhost": "docker compose --profile selfhost up -d --build --wait && docker compose --profile selfhost run --rm rustfs-init",
    "docker:reset-selfhost": "docker compose --profile selfhost down -v",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "mastra:dev": "mastra dev",
    "sandbox:modules": "deno bundle --minify --platform=browser --packages=bundle -o ./src/lib/sandbox/modules/mathjs.txt ./src/lib/sandbox/modules/mathjs-entry.ts"
  },
  "dependencies": {
    "@ai-sdk/provider-utils": "5.0.10",
