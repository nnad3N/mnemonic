  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --typecheck",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "fix": "nub run lint && nub run format",
    "translate": "gt generate",
    "docker:dev": "docker compose up -d",
    "docker:init": "docker compose up -d && docker compose run --rm rustfs-init",
    "docker:reset": "docker compose down -v",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "mastra:dev": "mastra dev",
    "sandbox:modules": "rolldown ./src/lib/sandbox/modules/mathjs-entry.ts --platform browser --format esm --minify -o ./src/lib/sandbox/modules/mathjs.txt && rolldown ./src/lib/sandbox/modules/papaparse-entry.ts --platform browser --format esm --minify -o ./src/lib/sandbox/modules/papaparse.txt",
