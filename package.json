    "@better-auth/passkey": "^1.6.26",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@jitl/quickjs-ng-wasmfile-release-sync": "^0.32.0",
