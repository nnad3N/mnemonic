    "@libpdf/core": "^0.4.1",
    "@libsql/client": "^0.17.4",
    "@mastra/ai-sdk": "^1.7.2",
    "@mastra/core": "^1.57.0",
    "@mastra/libsql": "^1.19.0",
    "@mastra/memory": "^1.26.0",
    "@mastra/rag": "^2.4.2",
